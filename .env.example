# Live-session relay credentials. When absent, development/tests use an in-memory
# relay that is NOT durable across serverless invocations (live sessions vanish).
# Provision a Redis/Upstash REST store (Vercel Marketplace) for production.
#
# Either credential pair is accepted (checked in this order):
#   1. KV_REST_API_URL / KV_REST_API_TOKEN              (legacy Vercel KV)
#   2. UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (Vercel Marketplace Upstash)
KV_REST_API_URL="https://your-redis-provider.example"
KV_REST_API_TOKEN="replace-me"
# UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="replace-me"

# Optional defaults
KUDOS_LIVE_TTL_SECONDS="43200"
KUDOS_POLL_INTERVAL_MS="1200"
