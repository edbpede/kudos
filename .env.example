# Optional live-session relay. When absent, local development uses an in-memory relay.
# Configure these with a Vercel Marketplace Redis/Upstash-compatible provider for production.
KV_REST_API_URL="https://your-redis-provider.example"
KV_REST_API_TOKEN="replace-me"

# Optional defaults
KUDOS_LIVE_TTL_SECONDS="43200"
KUDOS_POLL_INTERVAL_MS="1200"
