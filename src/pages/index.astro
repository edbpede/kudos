---
import PrivacyNotice from "../components/common/PrivacyNotice.astro";
import SetupWorkspace from "../components/setup/SetupWorkspace.svelte";
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Kudos setup">
  <main id="main-content" class="k-page">
    <div class="grid gap-4">
      <section class="px-1 py-2 sm:py-3" aria-labelledby="landing-heading">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2">
            <span class="grid size-8 place-items-center rounded-xl border border-emerald-300/20 bg-emerald-300/10 text-emerald-100">
              <svg aria-hidden="true" focusable="false" class="size-5" viewBox="0 0 32 32" fill="none">
                <path d="M16 3.5l3.65 7.39 8.16 1.19-5.91 5.76 1.4 8.13L16 22.14l-7.3 3.83 1.4-8.13-5.91-5.76 8.16-1.19L16 3.5z" fill="currentColor" opacity=".95" />
                <path d="M12.1 16.1l2.35 2.35 5.8-6.15" stroke="#062016" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <p class="k-eyebrow">Kudos</p>
          </div>
          <h1 id="landing-heading" class="mt-2 text-2xl font-bold tracking-tight text-white sm:text-4xl">
            Build a classroom rewards board in three guided steps.
          </h1>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">
            Set the roster, tune board details, then review and launch a classroom display.
          </p>
        </div>
      </section>
      <SetupWorkspace client:load />
      <PrivacyNotice />
    </div>
  </main>
</AppLayout>
