<section class="k-card p-4 sm:p-5" aria-labelledby="privacy-heading">
  <div class="grid gap-4 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,2fr)] lg:items-center">
    <div>
      <p class="k-eyebrow">Privacy reassurance</p>
