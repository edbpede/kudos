<section class="k-card relative overflow-hidden p-5 sm:p-6" aria-labelledby="privacy-heading">
  <div class="absolute -right-12 -top-16 h-40 w-40 rounded-full bg-emerald-300/20 blur-3xl"></div>
  <div class="relative grid gap-5 lg:grid-cols-[1.1fr_2fr] lg:items-center">
    <div>
      <p class="k-eyebrow">Local-first command center</p>
      <h2 id="privacy-heading" class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">
        Private by default, bright on the board.
      </h2>
      <p class="mt-3 text-base leading-7 text-slate-300">
        Build and run a classroom rewards display without turning student data into a permanent cloud record.
      </p>
    </div>
    <div class="grid gap-3 md:grid-cols-3">
      <article class="k-panel p-4">
        <span class="k-pill">01 Browser</span>
        <h3 class="mt-4 font-black text-emerald-50">Templates stay local</h3>
        <p class="mt-2 text-sm leading-6 text-slate-300">Class templates are saved in this teacher browser unless you choose to export them.</p>
      </article>
      <article class="k-panel p-4">
        <span class="k-pill">02 Temporary</span>
        <h3 class="mt-4 font-black text-emerald-50">Live sessions expire</h3>
        <p class="mt-2 text-sm leading-6 text-slate-300">Live mode sends only the state needed by the display and is designed for short classroom use.</p>
      </article>
      <article class="k-panel p-4">
        <span class="k-pill">03 Read-only</span>
        <h3 class="mt-4 font-black text-emerald-50">Display links cannot write</h3>
        <p class="mt-2 text-sm leading-6 text-slate-300">Teacher tokens never appear in display payloads or exported class JSON.</p>
      </article>
    </div>
  </div>
</section>
