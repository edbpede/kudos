{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"types": ["astro/client", "bun-types"]
	},
	"include": [
		".astro/types.d.ts",
		"src/**/*",
		"tests/**/*",
		"astro.config.ts",
		"uno.config.ts",
		"svelte.config.js"
	],
	"exclude": ["dist"]
}
